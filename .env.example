# Copy this file to .env and fill in your values.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Shop contacts shown on the site
QADAM_SELLER_PHONE=+996 555 000 000
QADAM_SELLER_ADDRESS=Бишкек, рынок Дордой
QADAM_SELLER_HOURS=09:00–17:00
QADAM_SELLER_INSTAGRAM=https://www.instagram.com/your_shop

# Database. Leave empty to use local SQLite.
# DATABASE_URL=postgres://qadam:qadam@localhost:5432/qadam

# Production only: https://your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
